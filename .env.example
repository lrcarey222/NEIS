# ---------------------------------------------------------------------------
# NEIS Strategic Findings Auction — environment
# Copy to `.env.local` for local dev, or set these in your host's dashboard.
# Every value below has a working default, so the app boots with no .env at all.
# ---------------------------------------------------------------------------

# PIN for /control (the operator control room). CHANGE THIS BEFORE THE EVENT.
ADMIN_PIN=2026

# Default PIN handed to breakout facilitators. Per-breakout PINs are editable
# in /control -> Setup, and override this value once changed there.
BREAKOUT_PIN=1234

# Where the event JSON file is written. Defaults to ./data next to the project.
# On a host with a persistent disk, point this at the mounted volume.
NEIS_DATA_DIR=./data

# Base URL used to render the QR codes on the landing page. Leave unset and the
# app infers it from the incoming request, which is correct in almost all cases.
# NEIS_PUBLIC_URL=https://neis-auction.example.org
